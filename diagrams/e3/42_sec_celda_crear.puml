@startuml
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 12
skinparam sequence {
  ParticipantBackgroundColor #E8F0FB
  ParticipantBorderColor #1F3A5F
  LifeLineBorderColor #1F3A5F
  ArrowColor #1F3A5F
  GroupBackgroundColor #F5F7FA
}
skinparam NoteBackgroundColor #FFF6E0
skinparam NoteBorderColor #E8A317
title Secuencia 11 – Crear celda (iteración 2)
actor Administrador
participant "Navegador" as UI
participant "celdas_bp" as R
participant "CeldaService" as S
database "MySQL" as DB

Administrador -> UI : escribe código y tipo de celda
UI -> R : POST /celdas/nueva (csrf_token)
R -> R : admin_requerido
R -> S : crear(codigo, tipo)
alt código vacío, de más de 10 caracteres o con formato inválido, o tipo inválido
  S --> R : ReglaNegocioError
else datos válidos
  S -> DB : SELECT celda WHERE código = ?
  alt el código ya existe
    S --> R : ReglaNegocioError «Ya existe una celda con el código…»
  else código libre
    S -> DB : INSERT celda (estado LIBRE)
    DB --> S : commit
    S --> R : celda
    R --> UI : redirect a la lista «Celda … creada»
  end
end
R --> UI : (si hubo ReglaNegocioError) 400 + mensaje
@enduml
