@startuml
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 12
skinparam sequence {
  ParticipantBackgroundColor #E8F0FB
  ParticipantBorderColor #1F3A5F
  LifeLineBorderColor #1F3A5F
  ArrowColor #1F3A5F
  GroupBackgroundColor #F5F7FA
}
skinparam NoteBackgroundColor #FFF6E0
skinparam NoteBorderColor #E8A317
title Secuencia 12 – Editar celda (iteración 2)
actor Administrador
participant "Navegador" as UI
participant "celdas_bp" as R
participant "CeldaService" as S
database "MySQL" as DB

Administrador -> UI : cambia código o tipo de una celda
UI -> R : POST /celdas/{id}/editar (csrf_token)
R -> R : admin_requerido
R -> S : editar(id, codigo, tipo)
S -> DB : SELECT celda WHERE id = ?
alt la celda no existe
  S --> R : NoEncontradoError
  R --> UI : 404
else existe
  alt la celda está OCUPADA
    S --> R : ReglaNegocioError «tiene un vehículo dentro»
  else no está ocupada
    alt código o tipo inválidos
      S --> R : ReglaNegocioError
    else datos válidos
      S -> DB : ¿otra celda con ese código? ¿tiene historial de movimientos?
      alt código repetido
        S --> R : ReglaNegocioError «Ya existe una celda…»
      else cambia el tipo y la celda tiene historial
        S --> R : ReglaNegocioError «tiene historial de movimientos»
      else cambio permitido
        S -> DB : UPDATE celda (código, tipo)
        DB --> S : commit
        S --> R : celda
        R --> UI : redirect a la lista «Celda actualizada»
      end
    end
  end
end
R --> UI : (si hubo ReglaNegocioError) 400 + mensaje
@enduml
