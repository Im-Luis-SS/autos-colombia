@startuml
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 12
skinparam sequence {
  ParticipantBackgroundColor #E8F0FB
  ParticipantBorderColor #1F3A5F
  LifeLineBorderColor #1F3A5F
  ArrowColor #1F3A5F
  GroupBackgroundColor #F5F7FA
}
skinparam NoteBackgroundColor #FFF6E0
skinparam NoteBorderColor #E8A317
title Secuencia 2 – Control de acceso a una pantalla administrativa
actor Usuario
participant "Navegador" as UI
participant "Ruta protegida\n(usuarios, clientes, celdas, pagos…)" as R
participant "security.py\n(login_requerido / admin_requerido)" as SEC
Usuario -> UI : abre una pantalla administrativa
UI -> R : GET /usuarios (o /clientes, /celdas, /pagos…)
R -> SEC : ¿hay sesión? ¿el rol es Administrador?
alt no hay sesión
  SEC --> UI : redirect /login «Inicie sesión para continuar»
else sesión de Operario
  SEC --> UI : redirect al panel «Esta sección es solo para administradores»
else sesión de Administrador
  SEC --> R : continúa
  R --> UI : 200 pantalla solicitada
end
Usuario -> UI : envía un formulario (POST)
UI -> R : POST sin ficha CSRF de la sesión
R --> UI : 400 «La solicitud no es válida o la sesión expiró»
@enduml
