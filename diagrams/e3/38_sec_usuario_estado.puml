@startuml
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 12
skinparam sequence {
  ParticipantBackgroundColor #E8F0FB
  ParticipantBorderColor #1F3A5F
  LifeLineBorderColor #1F3A5F
  ArrowColor #1F3A5F
  GroupBackgroundColor #F5F7FA
}
skinparam NoteBackgroundColor #FFF6E0
skinparam NoteBorderColor #E8A317
title Secuencia 7 – Activar o desactivar usuario (iteración 2)
actor Administrador
participant "Navegador" as UI
participant "usuarios_bp" as R
participant "UsuarioService" as S
database "MySQL" as DB

Administrador -> UI : pulsa «Desactivar» (o «Activar»)
UI -> R : POST /usuarios/{id}/estado (csrf_token)
R -> R : admin_requerido
R -> S : cambiar_estado(id, activo, administrador actual)
S -> DB : SELECT usuario WHERE id = ?
alt el usuario no existe
  S --> R : NoEncontradoError
  R --> UI : 404
else existe
  alt se desactiva y es el propio administrador que actúa
    S --> R : ReglaNegocioError «No puede desactivar su propio usuario»
  else se desactiva al último administrador activo
    S --> R : ReglaNegocioError «último administrador activo»
  else cambio permitido
    S -> DB : UPDATE usuario SET activo = ?
    DB --> S : commit
    S --> R : usuario
    R --> UI : redirect «Usuario … desactivado/activado»
    note right of R : un usuario desactivado ya no\npuede iniciar sesión (ver secuencia 1)
  end
end
R --> UI : (si hubo ReglaNegocioError) redirect a la lista con el mensaje
@enduml
