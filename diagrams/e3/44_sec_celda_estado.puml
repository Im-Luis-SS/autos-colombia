@startuml
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 12
skinparam sequence {
  ParticipantBackgroundColor #E8F0FB
  ParticipantBorderColor #1F3A5F
  LifeLineBorderColor #1F3A5F
  ArrowColor #1F3A5F
  GroupBackgroundColor #F5F7FA
}
skinparam NoteBackgroundColor #FFF6E0
skinparam NoteBorderColor #E8A317
title Secuencia 13 – Poner una celda en mantenimiento o habilitarla (iteración 2)
actor Administrador
participant "Navegador" as UI
participant "celdas_bp" as R
participant "CeldaService" as S
database "MySQL" as DB

Administrador -> UI : pulsa «Mantenimiento» (o «Habilitar»)
UI -> R : POST /celdas/{id}/estado (estado, csrf_token)
R -> R : admin_requerido
R -> S : cambiar_estado(id, nuevo_estado)
S -> DB : SELECT celda WHERE id = ?
alt la celda no existe
  S --> R : NoEncontradoError
  R --> UI : 404
else existe
  alt el estado pedido no es LIBRE ni MANTENIMIENTO
    S --> R : ReglaNegocioError
  else celda OCUPADA
    S --> R : ReglaNegocioError «tiene un vehículo dentro»
  else ya está en ese estado
    S --> R : ReglaNegocioError «ya está en estado…»
  else cambio permitido
    S -> DB : UPDATE celda SET estado = ?
    DB --> S : commit
    S --> R : celda
    R --> UI : redirect «Celda … ahora está mantenimiento/libre»
    note right of R : el efecto sobre las entradas está en la\nregla de asignación (secuencia 3):\nsolo se asignan celdas LIBRES
  end
end
R --> UI : (si hubo ReglaNegocioError) redirect a la lista con el mensaje
@enduml
