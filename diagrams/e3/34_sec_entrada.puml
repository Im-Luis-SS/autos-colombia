@startuml
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam defaultFontSize 12
skinparam sequence {
  ParticipantBackgroundColor #E8F0FB
  ParticipantBorderColor #1F3A5F
  LifeLineBorderColor #1F3A5F
  ArrowColor #1F3A5F
  GroupBackgroundColor #F5F7FA
}
skinparam NoteBackgroundColor #FFF6E0
skinparam NoteBorderColor #E8A317
title Secuencia 3 – Registrar entrada y asignar celda (iteración 1)
actor Operario
participant "Navegador" as UI
participant "movimientos_bp" as R
participant "MovimientoService" as S
database "MySQL" as DB

Operario -> UI : escribe placa, celda (opcional) y observaciones
UI -> R : POST /entrada (csrf_token)
R -> R : login_requerido
R -> S : registrar_entrada(placa, operario, observaciones, celda)
alt observaciones de más de 255 caracteres
  S --> R : ReglaNegocioError
else nota válida
  S -> DB : SELECT vehículo WHERE placa = ?
  alt placa vacía, mal formada o vehículo no registrado
    S --> R : ReglaNegocioError
  else vehículo registrado
    S -> DB : ¿mensualidad ACTIVA que cubra hoy?
    alt sin mensualidad vigente (vencida, cancelada o inexistente)
      S --> R : ReglaNegocioError «sin mensualidad vigente»
    else mensualidad vigente
      S -> DB : ¿movimiento abierto del vehículo?
      alt ya está dentro
        S --> R : ReglaNegocioError «ya se encuentra dentro»
      else no está dentro
        group Regla de asignación de celda
          alt el operario indicó una celda
            S -> DB : SELECT celda WHERE código = ?
            note right of S : debe existir, ser del tipo del vehículo\ny estar LIBRE; si está OCUPADA o en\nMANTENIMIENTO se rechaza
          else asignación automática
            S -> DB : SELECT celda WHERE tipo = tipo del vehículo\nAND estado = 'LIBRE' ORDER BY código LIMIT 1
            note right of S : las celdas en MANTENIMIENTO\nu OCUPADAS quedan excluidas
          end
          alt no hay celda disponible
            S --> R : ReglaNegocioError «No hay celdas libres…»
          end
        end
        S -> DB : INSERT movimiento y celda → OCUPADA (commit)
        alt otro operario ocupó la celda o el vehículo a la vez (índice UNIQUE)
          DB --> S : IntegrityError
          S -> DB : rollback
          S --> R : ReglaNegocioError «intente de nuevo»
        else guardado
          DB --> S : commit
          S --> R : movimiento
          R --> UI : redirect «Entrada registrada: placa en la celda …»
        end
      end
    end
  end
end
R --> UI : (si hubo ReglaNegocioError) 400 + mensaje
@enduml
