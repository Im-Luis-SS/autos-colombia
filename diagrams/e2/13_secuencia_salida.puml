@startuml
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam sequence {
  ParticipantBackgroundColor #E8F0FB
  ParticipantBorderColor #1F3A5F
  LifeLineBorderColor #1F3A5F
}
title Secuencia – Registrar salida (iteración 1)
actor Operario
participant "Navegador" as UI
participant "movimientos_bp" as R
participant "MovimientoService" as S
database "MySQL" as DB
Operario -> UI : escribe placa (y nota de salida)
UI -> R : POST /salida
R -> S : registrar_salida(placa, operario, nota)
S -> DB : buscar movimiento abierto del vehículo
alt no está dentro
  S --> R : ReglaNegocioError
  R --> UI : 400 + mensaje
else está dentro
  S -> DB : fecha_hora_salida, observaciones_salida,\nceldas LIBRE
  DB --> S : commit
  S --> R : movimiento (con duración)
  R --> UI : redirect + "Salida registrada… Permanencia: …"
end
@enduml
