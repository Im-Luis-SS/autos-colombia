@startuml
skinparam shadowing false
skinparam defaultFontName Liberation Sans
skinparam sequence {
  ParticipantBackgroundColor #E8F0FB
  ParticipantBorderColor #1F3A5F
  LifeLineBorderColor #1F3A5F
}
title Secuencia – Crear usuario (iteración 2)
actor Administrador
participant "Navegador" as UI
participant "usuarios_bp" as R
participant "UsuarioService" as S
database "MySQL" as DB
Administrador -> UI : llena nombre, usuario, rol y contraseña
UI -> R : POST /usuarios/nuevo (csrf_token)
R -> R : proteger_csrf() y admin_requerido
R -> S : crear(nombre, username, clave, confirmación, rol)
S -> S : validar datos y política de contraseña
S -> DB : ¿existe el usuario? (sin distinguir mayúsculas)
alt datos inválidos o usuario repetido
  S --> R : ReglaNegocioError
  R --> UI : 400 + mensaje (conserva lo escrito)
else válido
  S -> S : cifrar contraseña (hash)
  S -> DB : INSERT usuario_sistema
  DB --> S : commit
  S --> R : usuario
  R --> UI : redirect a la lista + "Usuario creado"
end
@enduml
