@startuml 03a_clases_dominio
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam ArrowColor #1F3A5F
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
  BackgroundColor #F4F7FB
  BorderColor #1F3A5F
}
hide empty members
title Diagrama de clases (a) - Dominio

enum Rol {
  OPERARIO
  ADMINISTRADOR
}
enum TipoVehiculo {
  CARRO
  MOTO
}
enum EstadoCelda {
  LIBRE
  OCUPADA
  MANTENIMIENTO
}
enum EstadoMensualidad {
  ACTIVA
  VENCIDA
  CANCELADA
}

class Cliente {
  - id : int
  - tipoDocumento : str
  - numeroDocumento : str
  - nombres : str
  - apellidos : str
  - telefono : str
  - email : str
}

class Vehiculo {
  - id : int
  - placa : str
  - tipo : TipoVehiculo
  - marca : str
  - color : str
}

class Mensualidad {
  - id : int
  - fechaInicio : date
  - fechaFin : date
  - estado : EstadoMensualidad
  + estaVigente(fecha : date) : bool
}

class Celda {
  - id : int
  - codigo : str
  - tipo : TipoVehiculo
  - estado : EstadoCelda
  + ocupar() : void
  + liberar() : void
}

class Movimiento {
  - id : int
  - fechaHoraEntrada : datetime
  - fechaHoraSalida : datetime
  - observaciones : str
  + estaAbierto() : bool
  + registrarSalida(operario, fechaHora) : void
  + duracion() : timedelta
}

class UsuarioSistema {
  - id : int
  - nombre : str
  - username : str
  - passwordHash : str
  - rol : Rol
  - activo : bool
  + verificarClave(clave : str) : bool
  + esAdministrador() : bool
}

Cliente "1" -- "0..*" Vehiculo : es propietario de
Vehiculo "1" -- "0..*" Mensualidad : tiene
Vehiculo "1" -- "0..*" Movimiento : genera
Celda "1" -- "0..*" Movimiento : se usa en
UsuarioSistema "1" -- "0..*" Movimiento : registra entrada
UsuarioSistema "0..1" -- "0..*" Movimiento : registra salida

Vehiculo .. TipoVehiculo
Celda .. EstadoCelda
Mensualidad .. EstadoMensualidad
UsuarioSistema .. Rol
@enduml
